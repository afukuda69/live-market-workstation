# Copy to backend/.env and adjust. No API keys are needed for Part 4.1.
FEED_MODE=yahoo            # yahoo | mock | off
SYMBOLS=BTC-USD,AAPL,SPY   # BTC-USD trades 24/7, useful when US markets are closed
INTERVAL_SECONDS=60
DB_PATH=data/market.db
FINALIZE_GRACE_SECONDS=5
STALE_AFTER_SECONDS=30
BACKFILL_HISTORY=1
# YAHOO_WS_URL=wss://streamer.finance.yahoo.com/?version=2
