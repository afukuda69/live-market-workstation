# Copy to backend/.env and adjust. No API keys are needed for Part 4.1.
FEED_MODE=yahoo            # yahoo | mock | off
SYMBOLS=BTC-USD,AAPL,SPY   # BTC-USD trades 24/7, useful when US markets are closed
INTERVAL_SECONDS=60
DB_PATH=data/market.db
FINALIZE_GRACE_SECONDS=5
STALE_AFTER_SECONDS=30
BACKFILL_HISTORY=1
# YAHOO_WS_URL=wss://streamer.finance.yahoo.com/?version=2

# ---- Part 4.2 ----
SMA_FAST=10                # fast SMA window, in completed candles
SMA_SLOW=30                # slow SMA window
SIM_ENABLED=1              # live paper trading on/off
SIM_INITIAL_CASH=100000
SIM_FEE_BPS=10             # 0.10 % fee per fill
SIM_SLIPPAGE_BPS=5         # 0.05 % price slippage against the trader
SIM_ALLOCATION=1.0         # fraction of cash used per buy
